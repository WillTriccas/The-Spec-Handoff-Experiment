{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/spec-demo/audit-adapter.schema.json",
  "title": "Audit feature black-box adapter",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "workingDirectory",
    "initialize",
    "propose",
    "decide",
    "export"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "workingDirectory": { "type": "string", "minLength": 1 },
    "initialize": { "$ref": "#/$defs/command" },
    "propose": { "$ref": "#/$defs/command" },
    "decide": { "$ref": "#/$defs/command" },
    "export": { "$ref": "#/$defs/command" }
  },
  "$defs": {
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["executable", "arguments", "allowedExitCodes"],
      "properties": {
        "executable": { "type": "string", "minLength": 1 },
        "arguments": {
          "type": "array",
          "items": { "type": "string" }
        },
        "allowedExitCodes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 0 }
        }
      }
    }
  }
}
