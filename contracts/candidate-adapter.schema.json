{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/spec-demo/candidate-adapter.schema.json",
  "title": "Candidate build and execution adapter",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "workingDirectory",
    "build",
    "test",
    "run",
    "outputs"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "workingDirectory": { "type": "string", "minLength": 1 },
    "build": { "$ref": "#/$defs/command" },
    "test": { "$ref": "#/$defs/command" },
    "run": { "$ref": "#/$defs/command" },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["executable", "arguments", "allowedExitCodes"],
      "properties": {
        "executable": { "type": "string", "minLength": 1 },
        "arguments": {
          "type": "array",
          "items": { "type": "string" }
        },
        "allowedExitCodes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 0 }
        }
      }
    }
  }
}

