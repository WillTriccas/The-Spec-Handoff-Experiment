{
  "schemaVersion": "2.0.0",
  "weights": {
    "functionalCorrectness": 35,
    "behaviorPreservation": 20,
    "securityControls": 15,
    "maintainability": 15,
    "operability": 10,
    "scopeTraceability": 5
  },
  "allHardGates": [
    "build",
    "essential-business-invariants",
    "no-critical-security-findings",
    "maker-checker-separation",
    "audit-integrity"
  ],
  "hardGatesByEpisode": {
    "modernization": [
      "build",
      "essential-business-invariants",
      "no-critical-security-findings"
    ],
    "audit-feature": [
      "build",
      "essential-business-invariants",
      "no-critical-security-findings",
      "maker-checker-separation",
      "audit-integrity"
    ]
  },
  "claimRule": {
    "comparisonLane": "mai-spec",
    "controlLane": "opus-raw",
    "equivalentWithinPoints": 3,
    "betterByMoreThanPoints": 3,
    "aggregation": "marginal-medians",
    "requireAllHardGates": true,
    "comparisonLaneGatesDetermineEligibility": true,
    "controlLaneGateFailuresAreReportedSeparately": true,
    "overallRollup": "weaker-episode",
    "qualityAndEfficiencyVerdictsAreSeparate": true,
    "requireLowerMedianProductiveTime": true,
    "requireLowerMedianImplementationTokens": true,
    "notes": "The headline hypothesis is supported per episode only when MAI executing the Opus-authored Spec Kit artifacts is equivalent-or-better on quality, every MAI run passes all applicable hard gates, and MAI uses both fewer median implementation tokens and less median productive execution time than Opus tackling the raw task directly."
  },
  "efficiencyRule": {
    "primaryMetrics": [
      "implementation-token-total",
      "end-to-end-token-total-including-amortized-authoring"
    ],
    "tokenCategories": [
      "uncached-input",
      "cached-input",
      "output",
      "reasoning"
    ],
    "productiveExecutionTimeIsPrimary": true,
    "wallClockElapsedTimeIsSecondary": true,
    "queueAndThrottleTimeExcludedFromProductiveTime": true,
    "unknownCostIsUnavailable": true,
    "monetaryCostIsNotAHeadlineMetric": true
  },
  "secondaryClaimRules": [],
  "failedRunTreatment": {
    "includeInAggregation": true,
    "qualityScore": 0,
    "applicableGates": "failed"
  }
}
