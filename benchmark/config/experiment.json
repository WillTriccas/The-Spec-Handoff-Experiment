        "reasoningEffort": "high"
      }
    },
    "mai": {
      "id": "mai-code-1.1-flash",
      "displayName": "MAI Code 1.1 Flash",
      "buildId": "not-exposed-by-copilot",
      "agentVersion": "1.0.80",
      "agentBuildId": "not-separately-exposed-by-copilot",
      "effortParams": {
        "reasoningEffort": "high"
      }
    }
  },
  "episodes": [
    {
      "id": "modernization",
      "name": "Legacy trade-reconciliation modernization",
      "baselineRef": "refs/tags/baseline-legacy-trade-reconciliation-v1",
