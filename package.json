{
  "name": "the-spec-handoff-experiment",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "benchmark",
    "dashboard",
    "evaluator",
    "spec-factory"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "check": "npm run check --workspaces --if-present",
    "validate:framework": "node scripts/validate-framework.js",
    "validate": "pwsh -NoProfile -File scripts/validate.ps1 -SkipNpmInstall"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "devDependencies": {
    "jsdom": "29.0.1"
  }
}
