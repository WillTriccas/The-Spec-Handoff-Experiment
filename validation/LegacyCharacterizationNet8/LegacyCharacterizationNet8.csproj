<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\src\legacy-trade-reconciliation\LegacyTradeReconciliation\**\*.cs"
             Exclude="..\..\src\legacy-trade-reconciliation\LegacyTradeReconciliation\Program.cs;..\..\src\legacy-trade-reconciliation\LegacyTradeReconciliation\bin\**\*;..\..\src\legacy-trade-reconciliation\LegacyTradeReconciliation\obj\**\*" />
    <Compile Include="..\..\src\legacy-trade-reconciliation\tests\LegacyTradeReconciliation.CharacterizationTests\Program.cs" />
    <Content Include="..\..\src\legacy-trade-reconciliation\tests\LegacyTradeReconciliation.CharacterizationTests\Fixtures\**\*">
      <Link>Fixtures\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
